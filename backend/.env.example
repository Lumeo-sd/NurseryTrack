# Database Configuration
DATABASE_URL=postgresql://nurserytrack_user:nurserytrack_password@postgres:5432/nurserytrack
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nurserytrack
DB_USER=nurserytrack_user
DB_PASSWORD=nurserytrack_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Server Configuration
PORT=3005
NODE_ENV=development

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=nursery-photos
MINIO_USE_SSL=false

# CORS Configuration
CORS_ORIGIN=http://localhost:19000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
